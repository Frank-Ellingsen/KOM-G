table Tidsintelligens
	lineageTag: e6593452-9b55-4a64-9f44-8cb3123851aa

	calculationGroup
		precedence: 1

		calculationItem Current = SELECTEDMEASURE()

		calculationItem YTD = TOTALYTD(SELECTEDMEASURE(), 'dim_date'[Dato])

		calculationItem 'Forrige Måned (PM)' =
				CALCULATE (
				    SELECTEDMEASURE (),
				    DATEADD ( 'dim_date'[Dato], -1, MONTH )
				)

		calculationItem 'MoM Endring Kr' =
				VAR _Current = SELECTEDMEASURE ()
				VAR _PM =
				    CALCULATE (
				        SELECTEDMEASURE (),
				        DATEADD ( 'dim_date'[Dato], -1, MONTH )
				    )
				RETURN
				    IF ( NOT ISBLANK ( _PM ), _Current - _PM )

	column Periode
		dataType: string
		lineageTag: 367ba4f1-344d-45f8-b3d5-ee5315b74681
		summarizeBy: none
		sourceColumn: Name
		sortByColumn: Ordinal

		annotation SummarizationSetBy = Automatic

	column Ordinal
		dataType: int64
		isHidden
		lineageTag: 7a64ce19-8692-491a-af8d-b3bc4f3d2f21
		summarizeBy: sum
		sourceColumn: Ordinal

		annotation SummarizationSetBy = Automatic

