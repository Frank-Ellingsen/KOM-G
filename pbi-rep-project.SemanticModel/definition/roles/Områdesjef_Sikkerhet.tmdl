role Områdesjef_Sikkerhet
	modelPermission: read

	tablePermission dim_ansvar =
			VAR _User = USERPRINCIPALNAME()
			VAR _Allowed =
			    SELECTCOLUMNS(
			        FILTER(
			            'dim_sikkerhet',
			            'dim_sikkerhet'[Epost] = _User
			        ),
			        "Omrade_Kode", 'dim_sikkerhet'[Omrade_Kode]
			    )
			RETURN
			    "ALL" IN _Allowed || "*ALL*" IN _Allowed || [Omrade_Kode] IN _Allowed

	annotation PBI_Id = a488e04b2c12489ba019ecfa2e89bb02

